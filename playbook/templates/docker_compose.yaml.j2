version: '3.9'

services:
    selenoid1:
        image: aerokube/selenoid:1.11.3
        environment:
                - DOCKER_API_VERSION=1.44
        hostname: selenoid1
        networks:
            - selenoid_net1
        volumes:
            - /var/run/docker.sock:/var/run/docker.sock
            - {{ selenoid_path }}/browsers.json:/etc/selenoid/browsers.json:ro
        command: -container-network {{ network1 }} -limit 10

    selenoid2:
        image: aerokube/selenoid:1.11.3
        environment:
                - DOCKER_API_VERSION=1.44
        hostname: selenoid2
        networks:
            - selenoid_net2
        volumes:
            - /var/run/docker.sock:/var/run/docker.sock
            - {{ selenoid_path }}/browsers.json:/etc/selenoid/browsers.json:ro
        command: -container-network {{ network2 }} -limit 10

    ggr:
        image: aerokube/ggr:1.7.2
        hostname: ggr
        networks:
            - selenoid_net1
            - selenoid_net2
        volumes:
            - {{ selenoid_path }}/grid-router:/etc/grid-router:ro
        command: -guests-allowed -guests-quota "test" -verbose
        depends_on:
            - selenoid1
            - selenoid2

    ggr-ui:
        hostname: ggr-ui
        depends_on:
            - ggr
        image: aerokube/ggr-ui:1.2.0
        networks:
            - selenoid_net1
            - selenoid_net2
        volumes:
            - {{ selenoid_path }}/grid-router/quota/:/etc/grid-router/quota:ro

    selenoid-ui:
        hostname: selenoid-ui
        depends_on:
            - ggr-ui
        image: aerokube/selenoid-ui:1.10.11
        networks:
            - selenoid_net1
        command: --selenoid-uri http://ggr-ui:8888
        expose:
                - "8080"

    nginx:
        image: nginx:1.29.3
        hostname: nginx
        ports:
            - 8081:80
        volumes:
            - "{{ selenoid_path }}/selenoid.conf:/etc/nginx/conf.d/default.conf:ro"
        networks:
            - selenoid_net1
        depends_on:
            - selenoid-ui

networks:
    selenoid_net1:
        name: {{ network1 }}
        external: true
    selenoid_net2:
        name: {{ network2 }}
        external: true